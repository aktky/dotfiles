<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/llmctl install --apply fills @HOME@, @BREW_PREFIX@ and @LISTEN@. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.llm.llama-swap</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BREW_PREFIX@/bin/llama-swap</string>
    <string>--config</string>
    <string>@HOME@/.config/llama-swap/config.yaml</string>
    <string>--listen</string>
    <string>@LISTEN@</string>
    <string>--watch-config</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@BREW_PREFIX@/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>LLM_HOME</key>
    <string>@HOME@/.local/share/llm</string>
    <key>HF_HOME</key>
    <string>@HOME@/.local/share/llm/hf</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/llm/llama-swap.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/llm/llama-swap.log</string>
</dict>
</plist>
