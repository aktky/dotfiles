#!/bin/bash
set -euo pipefail
authenticate=false
case "${1:-}" in
  "") ;;
  --authenticate) authenticate=true ;;
  --help) echo "Usage: $0 [--authenticate]"; exit 0 ;;
  *) echo "Usage: $0 [--authenticate]" >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || exit 2
if ! command -v op >/dev/null 2>&1; then
  echo 'MISSING op: review and apply the Brewfile through scripts/bootstrap.' >&2
  exit 1
fi
printf '1Password CLI: %s\n' "$(command -v op)"
op --version
if ! $authenticate; then
  echo 'Installation check only. Use --authenticate for an interactive account check.'
  exit 0
fi
if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" || -n "${OP_CONNECT_HOST:-}" || -n "${OP_CONNECT_TOKEN:-}" ]]; then
  echo 'Automation credentials detected. Use a separate session for the desktop-account check.' >&2
  exit 1
fi
# Suppress account metadata, including authentication errors.
if op signin >/dev/null 2>&1 && op whoami >/dev/null 2>&1; then
  echo 'Account authentication succeeded. No vault items were read.'
else
  echo 'Authentication failed or was cancelled. See README.md.' >&2
  exit 1
fi
