#!/bin/bash
# Opt-in local LLM stack: llama-server (GGUF) and oMLX (MLX) behind llama-swap.
# Every command that changes something previews unless --apply is given.
set -euo pipefail
self="$0"
# Installed as an absolute symlink in ~/.local/bin; find the repo through it.
if [[ -L "$self" ]]; then self="$(readlink "$self")"; fi
source "$(dirname "$self")/common.sh"

llm_dir="$repo_root/config/llm"
label=local.llm.llama-swap
listen=127.0.0.1:8080

usage() {
  cat <<EOF
Usage: $0 <command> [options]
  install [--profile workstation|server] [--apply] [--links-only] [--target-home DIR]
                     Install config/llm/Brewfile, link configs, write the LaunchAgent
  pull [--apply] [NAME ...]
                     Download models listed in config/llm/models.tsv
                     (without names: the models the installed profile serves)
  start | stop | status
                     Control the llama-swap LaunchAgent (listens on $listen)
  serve [--off] [--apply]
                     Server profile: publish llama-swap to the tailnet with Tailscale Serve
  bench NAME [--apply]
                     Run llama-bench on a downloaded GGUF model and keep the result
  doctor [--profile workstation|server] [--links-only] [--target-home DIR]
                     Check links, LaunchAgent, tools, models and memory limit
Profiles: workstation (default) links llama-swap.yaml; server links
llama-swap.server.yaml. Later commands detect the profile from that link.
EOF
}

profile_yaml() {
  case "$1" in
    workstation) echo llama-swap.yaml ;;
    server) echo llama-swap.server.yaml ;;
    *) return 1 ;;
  esac
}

config_link() { printf '%s\n' "$target_home/.config/llama-swap/config.yaml"; }

# Installed profile, read from the config link; empty when not installed.
detect_profile() {
  local dest p
  dest="$(config_link)"
  [[ -L "$dest" ]] || return 0
  for p in workstation server; do
    if [[ "$(readlink "$dest")" == "$llm_dir/$(profile_yaml "$p")" ]]; then echo "$p"; return 0; fi
  done
}

llm_links() {
  printf '%s\n' 'config/llm/env|.config/llm/env' \
    "config/llm/$(profile_yaml "$profile")|.config/llama-swap/config.yaml" \
    'scripts/llmctl|.local/bin/llmctl'
}

find_tailscale() {
  tailscale_bin="$(command -v tailscale || true)"
  if [[ -z "$tailscale_bin" && -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
    tailscale_bin=/Applications/Tailscale.app/Contents/MacOS/Tailscale
  fi
  [[ -n "$tailscale_bin" ]]
}

# name|repo|include|size|format for each manifest entry.
model_rows() {
  local name repo include size format
  while IFS=$'\t' read -r name repo include size format; do
    [[ -z "$name" || "$name" == \#* ]] && continue
    printf '%s|%s|%s|%s|%s\n' "$name" "$repo" "$include" "$size" "$format"
  done < "$llm_dir/models.tsv"
}

# Where a model lives under LLM_HOME: GGUF for llama-server, MLX for oMLX.
format_dir() {
  case "$1" in
    gguf) echo models ;;
    mlx) echo mlx ;;
    *) return 1 ;;
  esac
}

# Model IDs defined under the top-level models: key of a llama-swap config
# (default: the workstation config).
routed_models() {
  awk '/^[^ #]/ { in_models = ($0 ~ /^models:/) } in_models && /^  [A-Za-z0-9._-]+:[[:space:]]*$/ {
    sub(/^  /, ""); sub(/:.*/, ""); print }' "${1:-$llm_dir/llama-swap.yaml}"
}

is_routed() {
  local routed
  while IFS= read -r routed; do [[ "$routed" == "$1" ]] && return 0; done < <(routed_models "$2")
  return 1
}

has_model() {
  local row
  while IFS= read -r row; do [[ "${row%%|*}" == "$1" ]] && return 0; done < <(model_rows)
  return 1
}

llm_home() { printf '%s\n' "$target_home/.local/share/llm"; }
plist_path() { printf '%s\n' "$target_home/Library/LaunchAgents/$label.plist"; }

brew_prefix() {
  if find_brew; then (cd "$(dirname "$brew_bin")/.." && pwd -P); else echo /opt/homebrew; fi
}

render_plist() {
  local prefix
  prefix="$(brew_prefix)"
  sed -e "s|@HOME@|$target_home|g" -e "s|@BREW_PREFIX@|$prefix|g" \
    -e "s|@LISTEN@|$listen|g" "$llm_dir/launchd/llama-swap.plist.in"
}

parse_home_opts() {
  apply=false; links_only=false; custom_home=false; strict=false; profile=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=true; shift ;;
      --links-only) links_only=true; shift ;;
      --target-home) [[ $# -ge 2 ]] || { usage; exit 2; }; target_home="$2"; custom_home=true; shift 2 ;;
      --profile) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; profile="$2"; shift 2 ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  if $custom_home && ! $links_only; then
    echo '--target-home requires --links-only (Homebrew is machine-wide).' >&2; exit 2
  fi
  normalize_target
  [[ -n "$profile" ]] || profile="$(detect_profile)"
  [[ -n "$profile" ]] || profile=workstation
  profile_yaml "$profile" >/dev/null || { echo "Unknown profile: $profile (workstation or server)" >&2; exit 2; }
}

cmd_install() {
  parse_home_opts "$@"
  local conflicts=0 src rel dest plist rendered
  printf 'PROFILE: %s (config/llm/%s)\n' "$profile" "$(profile_yaml "$profile")"
  while IFS='|' read -r src rel; do
    dest="$target_home/$rel"
    if ! check_parent "$dest"; then conflicts=1; continue; fi
    if [[ -L "$dest" && "$(readlink "$dest")" == "$repo_root/$src" ]]; then
      printf 'OK link: %s\n' "$dest"
    elif [[ -e "$dest" || -L "$dest" ]]; then
      printf 'CONFLICT: %s (back up and move it explicitly first)\n' "$dest" >&2; conflicts=1
    else
      printf 'LINK: %s -> %s\n' "$dest" "$repo_root/$src"
    fi
  done < <(llm_links)
  plist="$(plist_path)"
  rendered="$(render_plist)"
  if ! check_parent "$plist"; then conflicts=1
  elif [[ -L "$plist" ]] || { [[ -e "$plist" ]] && [[ "$(cat "$plist")" != "$rendered" ]]; }; then
    printf 'CONFLICT: %s differs (run stop, then move it explicitly)\n' "$plist" >&2; conflicts=1
  elif [[ -e "$plist" ]]; then
    printf 'OK LaunchAgent: %s\n' "$plist"
  else
    printf 'WRITE LaunchAgent: %s (starts llama-swap at login)\n' "$plist"
  fi
  [[ "$conflicts" == 0 ]] || { echo 'Stopped before making any changes.' >&2; exit 1; }
  printf 'DIRS: %s/{models,mlx,omlx,hf,bench}, %s/Library/Logs/llm\n' "$(llm_home)" "$target_home"
  if ! $links_only; then
    printf 'PACKAGES: brew bundle install --no-upgrade --file=%s/Brewfile\n' "$llm_dir"
    printf 'TIME MACHINE: tmutil addexclusion %s\n' "$(llm_home)"
  fi
  if ! $apply; then echo 'Preview only. Use --apply to install and link.'; exit 0; fi
  if ! $links_only; then
    [[ "$(uname -s)" == Darwin ]] || { echo 'Package installation is macOS-only.' >&2; exit 2; }
    find_brew || { echo 'Install Homebrew from https://brew.sh, then rerun.' >&2; exit 1; }
    HOMEBREW_NO_AUTO_UPDATE=1 "$brew_bin" bundle install --no-upgrade --file="$llm_dir/Brewfile"
  fi
  while IFS='|' read -r src rel; do
    dest="$target_home/$rel"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$repo_root/$src" ]]; then continue; fi
    mkdir -p "$(dirname "$dest")"
    ln -s "$repo_root/$src" "$dest"
  done < <(llm_links)
  mkdir -p "$(llm_home)/models" "$(llm_home)/mlx" "$(llm_home)/omlx" "$(llm_home)/hf" "$(llm_home)/bench" \
    "$target_home/Library/Logs/llm" "$(dirname "$plist")"
  [[ -e "$plist" ]] || printf '%s\n' "$rendered" > "$plist"
  if ! $links_only; then tmutil addexclusion "$(llm_home)"; fi
  echo 'Applied. Open a new login shell, run llmctl pull, then llmctl start.'
  if [[ "$profile" == server ]]; then echo 'Then publish it to the tailnet with llmctl serve.'; fi
}

cmd_pull() {
  local apply=false names="" name repo include size format sub found any=false installed yaml=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=true; shift ;;
      -*) usage >&2; exit 2 ;;
      *) names="$names $1"; shift ;;
    esac
  done
  for name in $names; do
    has_model "$name" || { echo "Unknown model: $name (see config/llm/models.tsv)" >&2; exit 2; }
  done
  : "${LLM_HOME:?Run llmctl install --apply and open a new login shell}"
  installed="$(detect_profile)"
  if [[ -z "$names" && -n "$installed" ]]; then
    yaml="$llm_dir/$(profile_yaml "$installed")"
    printf 'PROFILE: %s (models routed by config/llm/%s)\n' "$installed" "${yaml##*/}"
  fi
  while IFS='|' read -r name repo include size format; do
    if [[ -n "$names" ]]; then
      found=false
      for want in $names; do [[ "$want" == "$name" ]] && found=true; done
      $found || continue
    elif [[ -n "$yaml" ]]; then
      is_routed "$name" "$yaml" || continue
    fi
    any=true
    sub="$(format_dir "$format")" || { echo "Bad format for $name: $format (gguf or mlx)" >&2; exit 2; }
    printf 'PULL %s (%s, ~%s GB): hf download %s --include %s --local-dir %s/%s/%s\n' \
      "$name" "$format" "$size" "$repo" "$include" "$LLM_HOME" "$sub" "$name"
    if $apply; then
      hf download "$repo" --include "$include" --local-dir "$LLM_HOME/$sub/$name"
    fi
  done < <(model_rows)
  $any || { echo 'No models listed.' >&2; exit 1; }
  $apply || echo 'Preview only. Use --apply to download.'
}

cmd_service() {
  local domain plist
  domain="gui/$(id -u)"
  plist="$(plist_path)"
  case "$1" in
    start)
      [[ -f "$plist" ]] || { echo 'No LaunchAgent; run llmctl install --apply first.' >&2; exit 1; }
      if launchctl print "$domain/$label" >/dev/null 2>&1; then
        launchctl kickstart -k "$domain/$label"
      else
        launchctl bootstrap "$domain" "$plist"
      fi
      echo "llama-swap: http://$listen (UI at /ui, OpenAI API at /v1)" ;;
    stop)
      launchctl bootout "$domain/$label" 2>/dev/null || echo 'llama-swap is not loaded.' ;;
    status)
      if launchctl print "$domain/$label" 2>/dev/null | grep -E $'^\t(state|pid) ='; then
        curl -fsS --max-time 3 "http://$listen/running" || echo 'API not answering yet.'
        echo
      else
        echo 'llama-swap is not loaded.'
      fi ;;
  esac
}

# Tailscale Serve proxies tailnet HTTPS to localhost; llama-swap keeps
# listening on 127.0.0.1 and is never reachable from other networks.
cmd_serve() {
  local apply=false off=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=true; shift ;;
      --off) off=true; shift ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  if [[ "$(detect_profile)" != server ]]; then
    echo 'serve is for the server profile: llmctl install --profile server --apply' >&2; exit 1
  fi
  if $off; then
    set -- serve --https=443 off
  else
    set -- serve --bg --https=443 "http://$listen"
  fi
  printf 'TAILSCALE: tailscale %s\n' "$*"
  $off || echo 'Every device on your tailnet can reach it; llama-swap has no API key.'
  $apply || { echo 'Preview only. Use --apply to change Tailscale Serve.'; exit 0; }
  find_tailscale || { echo 'Tailscale CLI not found; install Tailscale and sign in.' >&2; exit 1; }
  "$tailscale_bin" "$@"
  "$tailscale_bin" serve status || true
}

cmd_bench() {
  local name="" apply=false file out
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=true; shift ;;
      -*) usage >&2; exit 2 ;;
      *) [[ -z "$name" ]] || { usage >&2; exit 2; }; name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || { usage >&2; exit 2; }
  : "${LLM_HOME:?Run llmctl install --apply and open a new login shell}"
  if [[ -d "$LLM_HOME/mlx/$name" ]]; then
    echo "$name is an MLX model; use the oMLX benchmark instead (llama-bench reads GGUF only)." >&2; exit 2
  fi
  # First shard (or the single file), skipping multimodal projectors.
  file="$(find "$LLM_HOME/models/$name" -name '*.gguf' ! -name 'mmproj*' ! -path '*/MTP/*' 2>/dev/null \
    | LC_ALL=C sort | head -n 1)"
  [[ -n "$file" ]] || { echo "Not downloaded: $name (llmctl pull --apply $name)" >&2; exit 1; }
  out="$LLM_HOME/bench/$(date +%Y%m%d-%H%M%S)-$name.md"
  printf 'BENCH: llama-bench -m %s -p 512,4096 -n 128 -o md > %s\n' "$file" "$out"
  echo 'Stop llama-swap first (llmctl stop) so the two do not compete for memory.'
  $apply || { echo 'Preview only. Use --apply to run.'; exit 0; }
  {
    printf '# %s\n\n- date: %s\n- host: %s\n- llama.cpp: %s\n- wired_limit_mb: %s\n\n' \
      "$name" "$(date '+%Y-%m-%d %H:%M:%S')" "$(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -m)" \
      "$(llama-bench --version 2>&1 | grep -m1 version || echo unknown)" "$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo unknown)"
    llama-bench -m "$file" -p 512,4096 -n 128 -o md
  } | tee "$out"
}

cmd_doctor() {
  parse_home_opts "$@"
  local status=0 src rel dest name repo include size format sub limit mem_mb found routed
  while IFS='|' read -r src rel; do
    dest="$target_home/$rel"
    if [[ -L "$dest" && "$(readlink "$dest")" == "$repo_root/$src" && -e "$dest" ]]; then
      printf 'OK link: %s\n' "$rel"
    else
      printf 'MISSING/DIFFERENT link: %s\n' "$rel"; status=1
    fi
  done < <(llm_links)
  plist="$(plist_path)"
  if [[ -f "$plist" && ! -L "$plist" && "$(cat "$plist")" == "$(render_plist)" ]]; then
    echo 'OK LaunchAgent'
  else
    echo 'MISSING/DIFFERENT LaunchAgent: rerun install (stop and move a changed one first)'; status=1
  fi
  printf 'PROFILE: %s\n' "$profile"
  # The workstation config serves every manifest model; the server one a subset.
  while IFS='|' read -r name repo include size format; do
    format_dir "$format" >/dev/null || { echo "BAD FORMAT: $name ($format; use gguf or mlx)"; status=1; }
    is_routed "$name" "$llm_dir/llama-swap.yaml" ||
      { echo "NOT ROUTED: $name is in models.tsv but not llama-swap.yaml"; status=1; }
  done < <(model_rows)
  for yaml in "$llm_dir"/llama-swap*.yaml; do
    while IFS= read -r name; do
      has_model "$name" ||
        { echo "NOT IN MANIFEST: $name is routed by ${yaml##*/} but not in models.tsv"; status=1; }
    done < <(routed_models "$yaml")
  done
  yaml="$llm_dir/$(profile_yaml "$profile")"
  if $links_only; then exit "$status"; fi

  for tool in llama-server llama-swap hf omlx; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf 'PATH %s: %s\n' "$tool" "$(command -v "$tool")"
    else
      printf 'MISSING on PATH: %s\n' "$tool"; status=1
    fi
  done
  if command -v llama-server >/dev/null 2>&1; then
    printf 'llama.cpp: %s\n' "$(llama-server --version 2>&1 | grep -m1 version || echo unknown)"
  fi
  if command -v omlx >/dev/null 2>&1; then
    printf 'oMLX: %s\n' "$(omlx --version 2>&1 | tail -n 1)"
  fi
  while IFS='|' read -r name repo include size format; do
    sub="$(format_dir "$format")" || continue
    is_routed "$name" "$yaml" || continue
    if { [[ "$format" == gguf ]] && [[ -n "$(find "$(llm_home)/$sub/$name" -name '*.gguf' -print -quit 2>/dev/null)" ]]; } ||
       { [[ "$format" == mlx ]] && [[ -f "$(llm_home)/$sub/$name/config.json" ]] &&
         [[ -n "$(find "$(llm_home)/$sub/$name" -name '*.safetensors' -print -quit 2>/dev/null)" ]]; }; then
      printf 'OK model: %s (%s)\n' "$name" "$format"
    else
      printf 'NOT DOWNLOADED: %s (~%s GB; llmctl pull --apply %s)\n' "$name" "$size" "$name"
    fi
  done < <(model_rows)
  limit="$(sysctl -n iogpu.wired_limit_mb 2>/dev/null || echo 0)"
  mem_mb=$(( $(sysctl -n hw.memsize) / 1048576 ))
  if [[ "$limit" == 0 ]]; then
    printf 'GPU wired limit: macOS default (Metal working set, below %s MB RAM).\n' "$mem_mb"
    if [[ "$profile" == workstation ]]; then
      printf 'For the large MoE run:\n  sudo sysctl iogpu.wired_limit_mb=%s   # resets on reboot\n' $(( mem_mb - 16384 ))
    fi
  else
    printf 'GPU wired limit: %s MB of %s MB\n' "$limit" "$mem_mb"
  fi
  if [[ "$profile" == server ]]; then
    if ! find_tailscale; then
      echo 'MISSING Tailscale CLI: install Tailscale and sign in'; status=1
    elif "$tailscale_bin" serve status 2>/dev/null | grep -q "$listen"; then
      echo "OK Tailscale Serve: proxies to $listen"
    else
      echo 'NOT SERVED on the tailnet: llmctl serve --apply'; status=1
    fi
  fi
  exit "$status"
}

[[ $# -gt 0 ]] || { usage >&2; exit 2; }
command="$1"; shift
case "$command" in
  install) cmd_install "$@" ;;
  pull) cmd_pull "$@" ;;
  start|stop|status) [[ $# == 0 ]] || { usage >&2; exit 2; }; cmd_service "$command" ;;
  serve) cmd_serve "$@" ;;
  bench) cmd_bench "$@" ;;
  doctor) cmd_doctor "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
